# Banco de dados (conecta via PgBouncer em desenvolvimento; aponte para o host real em produção)
DB_HOST=db
DB_PORT=5432
DB_NAME=courses_api
DB_USER=api_user
DB_PASS=api_pass

# Redis — usado para rate limiting e idempotência
# Em produção aponte para um Redis gerenciado (ex.: ElastiCache, Redis Cloud)
# Se ausente, o sistema faz fallback para APCu (por instância) ou arquivos temporários
REDIS_HOST=redis
REDIS_PORT=6379
